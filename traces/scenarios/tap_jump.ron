(
    id: "tap_jump",
    tags: [
        "air",
        "jump",
    ],
    geometry: [
        Box((
            min: (-2000, -100, -2000),
            max: (2000, 0, 2000),
            kind: 0,
        )),
    ],
    start: (
        pos: (0, 0, 0),
        yaw_deg: 0.0,
        action: "Idle",
    ),
    camera: Fixed(
        yaw_deg: 0.0,
    ),
    inputs: [
        // Single-frame A tap (vs jump_hold_a.ron which holds A): jump-height
        // control quarters vy while A is not held, so this is a short hop.
        Press(
            stick: (0, 0),
            buttons: 1,
        ),
        Hold(
            frames: 40,
            stick: (0, 0),
            buttons: 0,
        ),
    ],
    compare: AirDefault,
)
