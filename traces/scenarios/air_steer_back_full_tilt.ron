(
    id: "air_steer_back_full_tilt",
    tags: [
        "air",
        "steering",
    ],
    geometry: [
        Box((
            min: (-2000, -100, -2000),
            max: (2000, 0, 2000),
            kind: 0,
        )),
    ],
    start: (
        pos: (0, 0, 0),
        yaw_deg: 0.0,
        action: "Idle",
    ),
    camera: Fixed(
        yaw_deg: 0.0,
    ),
    inputs: [
        // Neutral jump, then full-tilt backward air steering for the whole arc.
        Press(
            stick: (0, 0),
            buttons: 1,
        ),
        Hold(
            frames: 40,
            stick: (0, -80),
            buttons: 0,
        ),
    ],
    compare: AirDefault,
)
