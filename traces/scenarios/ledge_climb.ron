(
    id: "ledge_climb",
    tags: [
        "air",
        "wall",
        "ledge",
        "climb",
    ],
    geometry: [
        Box((
            min: (-2000.0, -100.0, -2000.0),
            max: (2000.0, 0.0, 2000.0),
            kind: 0,
        )),
        Box((
            min: (-200.0, 0.0, 400.0),
            max: (200.0, 400.0, 500.0),
            kind: 0,
        )),
    ],
    start: (
        pos: (0, 0, 0),
        yaw_deg: 0.0,
        action: "Idle",
    ),
    camera: Fixed(
        yaw_deg: 0.0,
    ),
    inputs: [
        Hold(
            frames: 25,
            stick: (0, 80),
            buttons: 0,
        ),
        Press(
            stick: (0, 80),
            buttons: 1,
        ),
        Hold(
            frames: 24,
            stick: (0, 80),
            buttons: 1,
        ),
        // Grab lands ~frame 42. Go neutral so the toward-stick slow climb
        // (timer >= 10) can't fire, then A for the fast climb.
        Hold(
            frames: 4,
            stick: (0, 0),
            buttons: 0,
        ),
        Press(
            stick: (0, 0),
            buttons: 1,
        ),
        Hold(
            frames: 40,
            stick: (0, 0),
            buttons: 0,
        ),
    ],
    compare: AirDefault,
    asserts: [
        ActionSeen(action: "LedgeGrab"),
        ActionSeen(action: "LedgeClimbFast"),
        // The climb must rise the body over the edge instead of traveling
        // horizontally at hang height (y=240) and snapping up, which drove
        // the head/shoulders through the ledge block. Frame accounting: the
        // goto frame records LedgeClimbFast before its tick runs, so 7 of
        // the 8 +20 rises land on frames carrying the action (240 -> 380);
        // the 8th lands on the pull_up transition into Idle at y=400.
        ActionEndPosY(action: "LedgeClimbFast", expected: 380.0, tol: 2.0),
    ],
)
