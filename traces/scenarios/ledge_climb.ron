(
    id: "ledge_climb",
    tags: [
        "air",
        "wall",
        "ledge",
        "climb",
    ],
    geometry: [
        Box((
            min: (-2000.0, -100.0, -2000.0),
            max: (2000.0, 0.0, 2000.0),
            kind: 0,
        )),
        Box((
            min: (-200.0, 0.0, 400.0),
            max: (200.0, 400.0, 500.0),
            kind: 0,
        )),
    ],
    start: (
        pos: (0, 0, 0),
        yaw_deg: 0.0,
        action: "Idle",
    ),
    camera: Fixed(
        yaw_deg: 0.0,
    ),
    inputs: [
        Hold(
            frames: 25,
            stick: (0, 80),
            buttons: 0,
        ),
        Press(
            stick: (0, 80),
            buttons: 1,
        ),
        Hold(
            frames: 24,
            stick: (0, 80),
            buttons: 1,
        ),
        // Grab lands ~frame 42. Go neutral so the toward-stick slow climb
        // (timer >= 10) can't fire, then A for the fast climb.
        Hold(
            frames: 4,
            stick: (0, 0),
            buttons: 0,
        ),
        Press(
            stick: (0, 0),
            buttons: 1,
        ),
        Hold(
            frames: 40,
            stick: (0, 0),
            buttons: 0,
        ),
    ],
    compare: AirDefault,
    asserts: [
        ActionSeen(action: "LedgeGrab"),
        ActionSeen(action: "LedgeClimbFast"),
        // The climb must go up-then-over instead of traveling horizontally
        // at hang height and snapping up, which drove the body through the
        // ledge. It rises 5x32 to the top at the hang xz (30 outside the
        // wall), travels 2x20 forward at the top level, then pull_up(+14)
        // lands on the ledge. Last carrying frame is y=400 (ledge top).
        ActionEndPosY(action: "LedgeClimbFast", expected: 400.0, tol: 2.0),
    ],
)
