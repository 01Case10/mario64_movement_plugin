(
    id: "long_jump",
    tags: [
        "air",
        "jump",
    ],
    geometry: [
        Box((
            min: (-4000.0, -100.0, -4000.0),
            max: (4000.0, 0.0, 4000.0),
            kind: 0,
        )),
    ],
    start: (
        pos: (0, 0, 0),
        yaw_deg: 0.0,
        action: "Idle",
    ),
    camera: Fixed(
        yaw_deg: 0.0,
    ),
    inputs: [
        Hold(
            frames: 40,
            stick: (0, 80),
            buttons: 0,
        ),
        Press(
            stick: (0, 80),
            buttons: 5,
        ),
        Hold(
            frames: 100,
            stick: (0, 80),
            buttons: 0,
        ),
    ],
    compare: AirDefault,
    asserts: [
        // Ground-truth entry velocity (decomp set_mario_action_airborne ACT_LONG_JUMP (30.0f)).
        ActionEntryVelY(action: "LongJump", expected: 30.0, tol: 1.0),
        // Ground-truth entry speed: decomp multiplies forwardVel by 1.5,
        // capped at 48. Entry fwd here is 31.60, so 31.60 * 1.5 = 47.40.
        ActionEntrySpeed(action: "LongJump", expected: 47.4, tol: 1.0),
    ],
)
