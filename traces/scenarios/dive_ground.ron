(
    id: "dive_ground",
    tags: [
        "air",
        "dive",
    ],
    geometry: [
        Box((
            min: (-4000.0, -100.0, -4000.0),
            max: (4000.0, 0.0, 4000.0),
            kind: 0,
        )),
    ],
    start: (
        pos: (0, 0, 0),
        yaw_deg: 0.0,
        action: "Idle",
    ),
    camera: Fixed(
        yaw_deg: 0.0,
    ),
    inputs: [
        Hold(
            frames: 60,
            stick: (0, 80),
            buttons: 0,
        ),
        Press(
            stick: (0, 80),
            buttons: 2,
        ),
        Hold(
            frames: 80,
            stick: (0, 0),
            buttons: 0,
        ),
    ],
    compare: AirDefault,
    asserts: [
        // Ground-truth entry speed: decomp ACT_DIVE adds 15 to forwardVel,
        // capped at 48. Entry fwd here is 32.11, so 32.11 + 15 = 47.11.
        ActionEntrySpeed(action: "Dive", expected: 47.1, tol: 1.0),
    ],
)
