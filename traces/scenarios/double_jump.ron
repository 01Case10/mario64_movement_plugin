        "chain",
    ],
    geometry: [
        Box((
            min: (-4000.0, -100.0, -4000.0),
            max: (4000.0, 0.0, 4000.0),
            kind: 0,
        )),
    ],
    start: (
        pos: (0, 0, 0),
        yaw_deg: 0.0,
        action: "Idle",
    ),
    camera: Fixed(
        yaw_deg: 0.0,
    ),
    inputs: [
        Hold(
            frames: 40,
            stick: (0, 80),
            buttons: 0,
        ),
        Press(
            stick: (0, 80),
            buttons: 1,
        ),
        Hold(
            frames: 25,
            stick: (0, 80),
            buttons: 1,
        ),
        Hold(
            frames: 1,
            stick: (0, 80),
            buttons: 0,
        ),
        Press(
            stick: (0, 80),
            buttons: 1,
        ),
        Hold(
            frames: 100,
            stick: (0, 80),
            buttons: 1,
        ),
    ],
    compare: AirDefault,
    asserts: [
        ActionSeen(action: "DoubleJump"),
        // Ground-truth entry velocity: decomp ACT_DOUBLE_JUMP sets
        // vel_y = 52 + 0.25 * forwardVel. Entry fwd here is 52.15
        // (41.72 recorded after the x0.8), so 52 + 52.15/4 = 65.04.
        ActionEntryVelY(action: "DoubleJump", expected: 65.0, tol: 1.0),
    ],
)
