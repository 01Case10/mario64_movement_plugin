(
    id: "sideflip",
    tags: [
        "air",
        "jump",
    ],
    geometry: [
        Box((
            min: (-2000.0, -100.0, -2000.0),
            max: (2000.0, 0.0, 2000.0),
            kind: 0,
        )),
    ],
    start: (
        pos: (0, 0, 0),
        yaw_deg: 0.0,
        action: "Idle",
    ),
    camera: Fixed(
        yaw_deg: 0.0,
    ),
    inputs: [
        Hold(
            frames: 30,
            stick: (0, 80),
            buttons: 0,
        ),
        Hold(
            frames: 3,
            stick: (0, -80),
            buttons: 0,
        ),
        Press(
            stick: (0, -80),
            buttons: 1,
        ),
        Hold(
            frames: 90,
            stick: (0, 0),
            buttons: 0,
        ),
    ],
    compare: AirDefault,
    asserts: [
        // Ground-truth entry velocity (decomp set_mario_action_airborne ACT_SIDE_FLIP (62.0f)).
        ActionEntryVelY(action: "SideFlip", expected: 62.0, tol: 1.0),
    ],
)
